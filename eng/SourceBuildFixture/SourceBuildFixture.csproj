<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>
  <ItemGroup><Compile Remove="Contexts/**/*.cs" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="PinguApps.Aspire.Hosting.Railway" Version="$(RailwayFixturePackageVersion)" />
    <PackageReference Include="PinguApps.Aspire.Hosting.Dashboard.Railway" Version="1.0.7" />
  </ItemGroup>
</Project>
